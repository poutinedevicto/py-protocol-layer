pipeline {
  agent {
    // LOCAVORA_TODO agent also defined in other Jenkinsfile 
    kubernetes {
      label 'jenkins-agent-kaniko-remote-harbor'
      idleMinutes 60 // Keep the Pod alive for 60 minutes after the build
      yaml '''
apiVersion: v1
kind: Pod
metadata:
  name: kaniko-builder
spec:
  volumes:
    - name: docker-config-secret
      secret:
        # Secret provient de Vault via un External Secret
        secretName: harbor-beckn-locavora-rw-external-secret
    # Volume pour stocker temporairement le contexte (code source) et l'image de sortie
    #- name: shared-data
    #  emptyDir: {}
  
  containers:  
  - name: kaniko
    # 'latest' aussi disponible mais 'debug' init. parce que sh dispo
    image: martizih/kaniko:debug
    command:
      - /busybox/sh
      - -c
      - "sleep infinity"
    #args:
    #  # Chemin vers le Dockerfile à l'intérieur du volume partagé
    #  # - --dockerfile=/workspace/code/Dockerfile
    #  # Chemin vers le contexte de construction (le code source cloné)
    #  # - --context=dir:///workspace/code/
    #  # Destination de l'image à pousser (remplacez par votre registre/nom:tag)
    #  #- --destination=monregistre.io/monimage:latest
    #  # Fichier d'authentification Docker (poussé via le volume secret)
    #  #- --oci-auth-file=/kaniko/.docker/config.json
        
    volumeMounts:
      - name: docker-config-secret
        mountPath: /kaniko/.docker
        readOnly: true

    resources:
      requests:
        ephemeral-storage: 10Gi

  restartPolicy: Never
'''   
    }
  }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    durabilityHint('PERFORMANCE_OPTIMIZED')
    disableConcurrentBuilds()
  }
  environment {
    REGISTRY_NAME = 'harbor.beckn.locavora.org'
    IMAGE_NAME = 'locavora-public/ondc-buyer-app-py-protocol'
    CACHE_NAME = 'locavora/dockerfile-build-cache'
  }
  stages {

    // LOCAVORA - attention on doit utiliser les apos (') pour que les variables d'environnement ne soient pas interprétées
    stage('Build with Kaniko Dockerfile in provided repo') {
      steps {
        container('kaniko') {
          sh 'cd webserver && \
                /kaniko/executor -c . --cache=true \
                --cache-repo $REGISTRY_NAME/$CACHE_NAME \
                --destination $REGISTRY_NAME/$IMAGE_NAME:latest'
        }
      }
    }
  }
}