# FROM python:3.11
FROM python:3.7-slim

# LOCAVORA update et install pip added sinon erreurs pip
# disable any prompts during package installation
ENV DEBIAN_FRONTEND noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
     python3-pip \
     build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install virtualenv using pip
RUN pip install virtualenv

WORKDIR /app

RUN virtualenv -p python3.7 cronenv

COPY cron_requirements.txt .

RUN cronenv/bin/pip3 install --no-cache-dir -r cron_requirements.txt


# LOCAVORA TODO - .dockerignore
COPY . .

ENTRYPOINT ["/app/cronenv/bin/python3", "-m", "main.cron.search_by_city"]
